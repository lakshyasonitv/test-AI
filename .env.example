# Gemini keys — comma-separated. These DO stack quota only if each key is from a
# DISTINCT Google Cloud project / Google account. Four teammates' own-account keys
# ≈ 4x free quota, legitimately. Two keys in the same project do NOT stack.
GEMINI_API_KEYS='your-gemini-api-key-here'

# Groq keys — comma-separated. Groq enforces limits at the ORG level, so extra keys
# in one account add NO quota; list them only for failover. Do NOT create multiple
# accounts to pool quota (Groq ToS prohibits it). If Groq throughput is the wall,
# upgrade that one account to the paid Developer tier.
GROQ_API_KEYS='your-groq-api-key-here'

# Models (override if the free-tier lineup changes — verify at the rate-limit pages).
# Groq deprecates and shuts down models on a rolling schedule — check
# https://console.groq.com/docs/deprecations before assuming a model id below still
# works. llama-3.3-70b-versatile was deprecated 2026-06-17, shut down 2026-08-16;
# openai/gpt-oss-120b is Groq's recommended replacement and is also cheaper.

GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_LITE=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# Web UI port (optional)
PORT=3000
