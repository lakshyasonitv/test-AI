# Gemini keys — comma-separated. These DO stack quota only if each key is from a
# DISTINCT Google Cloud project / Google account. Four teammates' own-account keys
# ≈ 4x free quota, legitimately. Two keys in the same project do NOT stack.
GEMINI_API_KEYS='your-key-here'


# Models (override if the free-tier lineup changes — verify at the rate-limit pages).
# Gemini deprecates preview model ids — check
# https://ai.google.dev/gemini-api/docs/models before assuming a model id below still
# works, rather than trusting this comment: gemini-3-flash-preview (this project's value
# until 2026-08) was a preview id, per that page as checked when it was replaced;
# gemini-3.6-flash is its GA replacement, confirmed live (generateContent present in
# supportedGenerationMethods) at the same time. gemini-3.1-flash-lite was checked stable
# until 2027-05-07 as of that same date — re-check the date at ai.google.dev before relying
# on it, don't assume this comment stayed current.

GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_LITE=gemini-3.1-flash-lite

# --- Azure OpenAI (optional second provider) ---
# The pipeline can call Azure OpenAI instead of Gemini. Selection is per-ROLE via
# LLM_PROVIDER, read once at request time — there is NO automatic fallback between
# providers and no per-run/per-organisation switch (see DECISIONS.md, the Azure provider
# record). With LLM_PROVIDER unset (the default) every call still goes to Gemini exactly as
# before; the Azure variables below are inert until that flag is set.
#
# LLM_PROVIDER          "gemini" (default) or "azure". Applies to the 'main' roles (IR
#                       generation, test-case generation, rewrite/translate). A malformed
#                       value is a fatal startup error, not a silent fallback.
# LLM_PROVIDER_LITE     provider for the 'lite' roles (plan, discovery, concept-label,
#                       failure analysis). Defaults to LLM_PROVIDER when unset, so setting
#                       only LLM_PROVIDER=azure moves BOTH roles to Azure. Set it to "gemini"
#                       to keep the cheap stages on Gemini.
# AZURE_OPENAI_ENDPOINT Resource URL, e.g. https://my-resource.openai.azure.com. REQUIRED
#                       when any role is on "azure".
# AZURE_OPENAI_API_KEY  SECRET — never commit this and never send it to a browser. This key
#                       is AZURE's completion key, NOT the same thing as an orgLlmConfig key,
#                       which remains Gemini-only.
# AZURE_OPENAI_DEPLOYMENT          The DEPLOYMENT name (not a model id) for 'main' roles,
#                                  e.g. gpt-deploy-1. REQUIRED when 'main' is on "azure".
#                                  Expected to name a gpt-5-mini deployment (needs vision).
# AZURE_OPENAI_DEPLOYMENT_LITE     Deployment for 'lite' roles. Defaults to
#                                  AZURE_OPENAI_DEPLOYMENT when unset. Expected gpt-4.1-mini
#                                  (Legacy status — see TECH_DEBT.md TD-93).
# AZURE_OPENAI_REASONING_EFFORT    reasoning_effort for 'main' roles only. Default "low".
#                                  gpt-5 is a reasoning model, so this is the one knob the
#                                  pipeline has over completion cost. May be "low"/"medium"/"high".
# AZURE_OPENAI_REASONING_EFFORT_LITE  reasoning_effort for 'lite' roles. NO default — sent
#                                  ONLY when set, and never falls back to the main variable:
#                                  gpt-4.1-mini (the lite deployment) rejects the parameter
#                                  outright because it is not a reasoning model.
#
# Retries for both providers run through the same backoff loop: a 429/503 waits (honouring
# the Retry-After header) and retries; a content_filter refusal is NOT a rate limit and is
# reported as an error instead of being retried. Per-stage token/spend lines in
# runs/<id>/08-llm-usage.json now carry which provider served them (plus reasoning tokens
# when the model reports them).
#
# LLM_CACHE_VERSION     Salt mixed into every LLM cache key (alongside provider/model). The
#                       disk half of the cache never expires, so bumping this value (e.g. to
#                       "2", "2026-09-16", anything new) invalidates ALL cached LLM results in
#                       one move — useful when a bug shipped a poisoned entry (run
#                       2026-09-16T07-10-56-871Z-2a364a79 cached zero test cases). Defaults to
#                       "1"; an empty/whitespace/empty-array result is never cached at all.
# LLM_PROVIDER=gemini
# LLM_PROVIDER_LITE=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_DEPLOYMENT_LITE=
# AZURE_OPENAI_REASONING_EFFORT=
# AZURE_OPENAI_REASONING_EFFORT_LITE=
# LLM_CACHE_VERSION=1

# Cost + reliability ceilings. All optional — the defaults shown are what the code uses.
# These are the levers that bound what one run can spend; raise them deliberately.
#
# LLM_TIMEOUT_MS          per-ATTEMPT abort for any Gemini call. A hung fetch never
#                         settles, so without this a run can sit at "ir started" forever.
#                         Worst case per call is LLM_TIMEOUT_MS x the backoff retry count.
# MAX_LLM_CALLS_PER_RUN   hard cap on LLM requests for a whole run, shared across every
#                         stage that calls Gemini (plan, discovery, testcases, ir,
#                         failure-analysis, heal) — not just IR. Real spend is recorded
#                         to runs/<id>/08-llm-usage.json, broken down per stage.
# MAX_IR_ATTEMPTS         IR generate/validate retries per test case. Each rejected IR
#                         (bad schema, ungrounded step, vacuous or hallucinated assertion)
#                         costs one attempt.
# MAX_LIVE_EXTENSIONS     browser replays allowed per case to discover pages behind a
#                         login/click. Each one is a real Chromium launch. NOTE: each replay
#                         also consumes one MAX_IR_ATTEMPTS attempt, so raising this without
#                         raising that leaves fewer attempts for actually converging on an IR.
# MAX_CONCURRENT_RUNS     pipeline runs in flight at once — bounds concurrent Chromium
#                         instances, i.e. how big a box this needs.
# SCREENSHOT_SETTLE_MS    gap between the frames used to detect that a page has stopped
#                         animating (default 150). Raise it if a site's entrance animation is
#                         slow enough that screenshots still land mid-fade.
# SCREENSHOT_MAX_SAMPLES  ceiling on those frames (default 10), so a page that animates forever
#                         can't stall a run.
# CREDENTIAL_WAIT_MS      how long a run pauses waiting for you to supply a login before
#                         giving up and testing without one. A paused run holds one of the
#                         MAX_CONCURRENT_RUNS slots, so don't set this very high. On an
#                         auth-aware run this prompt can fire mid-discovery, as soon as a
#                         live login gate is found — not only after case generation.
# MAX_LOGIN_CASES         on an auth-aware run, the max cases in a suite allowed to target the
#                         login page itself (default 1) — without this, category-diversity
#                         selection lets several differently-categorized login cases survive
#                         and the suite ends up testing the login screen instead of the app
#                         behind it. Your own "test the login page" request is never capped.
LLM_TIMEOUT_MS=45000
MAX_LLM_CALLS_PER_RUN=60
MAX_IR_ATTEMPTS=4
MAX_LIVE_EXTENSIONS=5
MAX_CONCURRENT_RUNS=3
SCREENSHOT_SETTLE_MS=150
SCREENSHOT_MAX_SAMPLES=10
CREDENTIAL_WAIT_MS=300000
MAX_LOGIN_CASES=1

# Case-selection gate — pauses a run after generating a batch of test cases so you can
# review/accept/reject them before they execute, and can ask for a regenerated batch
# ("not satisfied") instead of the model's first guess. Off by default: the pipeline runs
# straight through with no pause, same as before this feature existed.
# ENABLE_CASE_SELECTION_GATE  set to "true" to turn the gate on.
# MAX_CASE_REGEN_ATTEMPTS     "not satisfied" regeneration rounds allowed before the gate
#                             gives up and runs with whatever's been accepted so far.
# MAX_ACCUMULATED_CASES       cap on cases accepted into the pool across all rounds.
# CASE_SELECTION_WAIT_MS      how long a round stays parked waiting for your pick before it
#                             times out as "done" with nothing new accepted. A paused run
#                             holds one of the MAX_CONCURRENT_RUNS slots, same caveat as
#                             CREDENTIAL_WAIT_MS above.
ENABLE_CASE_SELECTION_GATE=false
MAX_CASE_REGEN_ATTEMPTS=3
MAX_ACCUMULATED_CASES=5
CASE_SELECTION_WAIT_MS=600000

# Editing cases AT the gate. When the gate is on, each proposed case can be opened and its
# title, steps and expected outcome changed, removed, or written from scratch, before anything
# is compiled or a browser is opened. That costs nothing and needs no flag.
# GATE_CASE_EDIT_AI           set to "true" to also offer "Ask for a change" on a proposed
#                             case: a Gemini call returns revised step SENTENCES as a diff.
#                             It PROPOSES only — applying fills the editor, and the round still
#                             has to be approved by a person, so nothing skips review. Off by
#                             default because it spends a model call per press, and a server
#                             with no Gemini key must not draw a button that always fails.
#                             Shares the /rewrite rate limit (20 calls / 15 min / user).
GATE_CASE_EDIT_AI=false

# AppModel context caps — bound the size of the lite model embedded in testCases.ts's and ir.ts's
# LLM prompts. A rich site (large tables, deep mega-menus) with no caps here can produce a
# 17,000+ line model JSON and trip a 413 from Gemini. Defaults sit above every page observed
# in this project's own sampled runs (max 87 elements/page, 2 forms/page, 9 fields/form, 18 nav
# nodes, 3 buttons/page, 28 headings/page) — no effect on an ordinary site, only engages on a
# genuinely richer one. Elements/forms/nav are capped preferring named, interactive-role content
# over anonymous/positional content, so a cap prunes noise before it prunes a login form.
# MAX_LITE_ELEMENTS_PER_PAGE   named/interactive elements kept per page before anonymous ones
#                              fill the rest of the budget.
# MAX_LITE_FORMS_PER_PAGE      <form>s kept per page.
# MAX_LITE_FORM_FIELDS         fields kept per form.
# MAX_LITE_NAV_NODES_PER_PAGE  total nodes (all levels combined) from a page's navigation tree —
#                              one shared budget across the whole tree, not per level, so a wide
#                              AND deep mega-menu can't multiply past it.
# MAX_LITE_NAV_DEPTH           navigation tree levels kept; deeper nodes are pruned to a leaf.
# MAX_LITE_BUTTONS_PER_PAGE    buttons kept per page.
# MAX_LITE_HEADINGS_PER_PAGE   headings kept per page.
MAX_LITE_ELEMENTS_PER_PAGE=150
MAX_LITE_FORMS_PER_PAGE=5
MAX_LITE_FORM_FIELDS=20
MAX_LITE_NAV_NODES_PER_PAGE=60
MAX_LITE_NAV_DEPTH=3
MAX_LITE_BUTTONS_PER_PAGE=40
MAX_LITE_HEADINGS_PER_PAGE=40

# DISCOVERY_HYDRATION_POLL_MS  Max time (ms) discovery will keep re-checking a page that
#                              extracted zero elements before accepting that as final — some
#                              sites render nothing until well after domcontentloaded (measured:
#                              0 elements at +800ms on a real heavy page, 347 by +2.8s). A page
#                              that genuinely never renders anything (an auth wall) still
#                              correctly resolves to 0, just after this budget instead of
#                              immediately. See TECH_DEBT.md TD-31.
DISCOVERY_HYDRATION_POLL_MS=6000

# Web UI port (optional)
PORT=3000

# CHROMIUM_EXTRA_ARGS — space-separated Chromium command-line flags forwarded to EVERY
# browser this server launches: DOM discovery, the hybrid/site-crawl browser, live-extend
# replays, and the generated spec's own Playwright run. Unset/empty = absolutely no change.
# Default empty. Required on Azure Container Apps -- the container's /dev/shm cannot be
# resized there, and its default 64MB makes Chromium crash or hang on busy pages:
#     CHROMIUM_EXTRA_ARGS="--disable-dev-shm-usage"
# Do NOT add --no-sandbox: Playwright's chromiumSandbox already defaults to disabled.
CHROMIUM_EXTRA_ARGS=

# Locale pinning. Applies to the SAME five browsers CHROMIUM_EXTRA_ARGS does, for the same
# reason: pinning only some of them is worse than pinning none.
#
# RUN_LOCALE       the locale every browser presents, e.g. "en-US" (the default), "de-DE".
#                  Sets navigator.language, the Accept-Language request header and number/date
#                  formatting. The header is sent as the BARE tag ("de-DE", not a
#                  "de-DE,de;q=0.9" q-list): Playwright derives it from the locale and an
#                  explicit header cannot override it, which is measured in
#                  tests/browserLocale.test.ts. Unpinned, each browser inherited the HOST's locale, so a site
#                  that content-negotiates was discovered in whatever language the container
#                  happened to ask for — and every later stage inherited it, down to the
#                  generated locators. A run that produced Korean test cases is the recorded
#                  symptom; the model was describing the page it was shown.
#                  Set it EXPLICITLY EMPTY (RUN_LOCALE=) to restore the old host-inherited
#                  behaviour exactly. That is the rollback switch. Leaving it UNSET is not the
#                  same thing — unset means the "en-US" default.
#                  A single run can override this via POST /api/runs {options:{locale}}, which
#                  is checked against an allow-list in src/browserLaunch.ts. This variable is
#                  not, being operator-set: any tag Chromium accepts will work.
# RUN_TIMEZONE     the timezone every browser reports, default "UTC". UTC rather than the host
#                  zone so a rendered date does not depend on which machine discovered the
#                  page. NOTE this changes dates a site renders, so a test asserting one may
#                  need its expectation regenerated.
#
# Both are also forwarded to the generated spec's own Playwright run (executor.ts sets them on
# the child; playwright.config.ts reads them), so a spec EXECUTES under the locale its site
# model was DISCOVERED under. Both feed the AppModel and browser-walk cache keys, so changing
# either re-keys those rather than serving a snapshot taken under the old one.
RUN_LOCALE=en-US
RUN_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Phased rollout flags (implentationplan.md). EVERY flag below defaults to OFF.
# With all of them unset, the server behaves exactly as it did before the phase
# that introduced them — that is the whole point, so leave them unset unless you
# are deliberately turning a capability on.
# ---------------------------------------------------------------------------

# RUN_RETENTION_DAYS  (Phase 1, Step 1.2) Delete runs/<id>/ directories once they are in a
#                     terminal state AND older than this many days. Hard floor: nothing under
#                     24h old is ever deleted, whatever this is set to. Unset or 0 = the job
#                     never starts and nothing under runs/ is read or removed.
# RUN_RETENTION_DAYS=0

# AUTH_ENABLED        (Phase 2, Step 2.1) "true" turns on Supabase Auth: every /api/* route
#                     except /api/health and /api/auth/config requires a valid session JWT and
#                     401s without one, and the UI shows login/sign-up screens. Unset/anything
#                     else = no auth, requests are attributed to a fixed synthetic local user.
#
#                     (Step 3.4) The flag also decides whether ROLES are enforced. With it off the
#                     synthetic user is a genuine owner of the bootstrap organisation, so every
#                     authorization check runs its normal path and passes — nothing is skipped or
#                     branched around, which is what stops a tenancy leak appearing the day a
#                     second account exists.
#
#                     NOTE: roles and organisation isolation also need DB_ENABLED=true, because
#                     membership lives in the database. AUTH_ENABLED=true with DB_ENABLED unset
#                     logs a loud warning and every signed-in user can see everything.
# AUTH_ENABLED=false

# SIGNUP_ENABLED      Whether the sign-up screen can actually create accounts. Defaults to ON
#                     (only "false" turns it off) — unlike every other flag here, because the
#                     sign-up screen only exists when AUTH_ENABLED=true, which is itself off by
#                     default. So the shipped default is still "no sign-up", and this flag only
#                     decides what happens once you have already opted into auth.
#
#                     *** SET THIS TO false BEFORE EXPOSING THIS SERVER BEYOND LOCALHOST. ***
#                     POST /api/auth/signup is unauthenticated by necessity and creates real
#                     accounts using the service-role key. It is rate-limited per IP (5 attempts
#                     per 15 minutes) but that is a speed bump, not access control: anyone who can
#                     reach the port can otherwise sign themselves up. Add members from the Team
#                     screen instead once your team exists.
# SIGNUP_ENABLED=false

# SUPABASE_URL             Project API URL. Required when AUTH_ENABLED=true or DB_ENABLED=true.
# SUPABASE_PUBLISHABLE_KEY Browser-safe publishable ("anon") key. Safe to commit/ship to clients —
#                          it grants only what row-level security allows. Used to verify JWTs and
#                          by the login form.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SUPABASE_SERVICE_ROLE_KEY  SECRET — bypasses row-level security. Never commit this and never
#                            send it to a browser. Needed for server-side database reads
#                            (DB_ENABLED) AND for role/membership lookups (Step 3.4). Copy from:
#                            Supabase Dashboard -> Project Settings -> API -> service_role
# SUPABASE_SERVICE_ROLE_KEY=

# DB_ENABLED          (Phase 3, Step 3.2) "true" puts the database in SHADOW MODE for reads:
#                     listRuns() reads from both Postgres and disk, logs any divergence, and
#                     still returns the DISK result. The database is never authoritative for the
#                     run list at this step — that is Step 3.3, gated on a few days of zero
#                     divergence. Unset = the database is not contacted at all.
#
#                     (Step 3.4) It ALSO enables the writes and lookups authorization depends on:
#                     new runs get a row recording which organisation owns them, and membership/
#                     role checks can be answered. Turning AUTH_ENABLED on without this means
#                     roles cannot be enforced — see the warning under AUTH_ENABLED.
# DB_ENABLED=false

# --- Plain-language step editing (docs/phases/PHASE_NL_STEPS_REPORT.md) ---
# When "true", the case editor offers "Write it for me" on a step line the parser
# cannot read: a Gemini call turns loose English ("click the login button") into the
# vocabulary the parser accepts. It PROPOSES only — approving still goes through the
# ordinary parse -> re-ground -> version path, so nothing skips review or grounding.
# Off by default: it spends a model call, so a server without a Gemini key must not
# advertise the button. Shares the /rewrite rate limit (20 calls / 15 min / user).
NL_STEPS_ENABLED=false

# --- Replay-time re-grounding (TECH_DEBT.md TD-77) ---
# When "true", a replay first re-grounds the steps that carry no css/testId against the
# LIVE page. Those are the steps inside something a CLICK reveals — a modal, a tab, the
# next page of a wizard — which discovery never crawled into, so they ship with a role
# and a name and nothing else and fall back to name/geometry matching at run time.
# It walks the case prefix in a real browser, snapshots what is on screen and grounds
# against it, using the same deterministic role/name matching as the editor's re-ground:
# ZERO LLM calls. It never writes back to the saved case (a model proposes, a person
# approves) — the grounding lands in the run's own cases/case-N/04-ir.json marked
# groundedAt:"replay" so you can see it and choose to save it. Any failure falls back
# to the saved steps, so it can never make a replay worse.
# Off by default: it costs a browser launch and a prefix walk before the run starts, and
# a fully-grounded case (the common replay) should not pay for it.
# REPLAY_REGROUND=false

# --- Dropdown selection (TECH_DEBT.md TD-79) ---
# How long a `select` step waits for its options to arrive, and how long the select/click
# action itself gets. Server-populated dropdowns are the norm, so waiting is the default.
# The wait exits the MOMENT the control is populated and still has no match: waiting the
# full timeout on a control that is simply the wrong one is how a resolution bug disguises
# itself as a slow network, which is exactly what happened on the LMS Manager dropdown.
# SELECT_TIMEOUT_MS=10000

# --- Self-heal (TECH_DEBT.md TD-83) ---
# When a test fails on a selector that looks like it moved, the pipeline can re-read the
# page, regenerate the IR against that fresh snapshot and run the case again. That is a
# second full browser run PLUS a full IR regeneration (~3.8k prompt tokens), and the user
# watches the tests run a second time after the run looked finished — so it is opt-in.
# The Settings toggle in the UI overrides this per run; this is only the default the
# server advertises and applies when the request says nothing.
# SELF_HEAL_DEFAULT=false

# --- Deterministic self-healing (Phase 1) ---
# When "true", a failed Playwright run first attempts a deterministic, structural fix
# (re-matching the failing step's IR target against the AppModel without re-snapshotting
# or calling an LLM) before falling back to the existing LLM-based heal path. This is
# fast and free — no browser relaunch, no model cost — and covers the common case where
# an element was renamed or moved but is still discoverable in the current AppModel.
# Off by default: the pipeline behaves exactly as it did before this feature existed.
DETERMINISTIC_HEAL=false

# --- "Ask for a change" element context (TECH_DEBT.md TD-91) ---
# The rewrite prompt is shown the controls that actually exist on the pages a case touches,
# taken from the case's source run model or, failing that, from cached verification walks
# for the same site. Without it the model guesses element names from the instruction's
# wording: asked to "navigate to the admin panel" it proposed Click on button "Admin Panel"
# — the page HEADING — for a control really called button "Admin".
# This caps that list. Same two bounds as the concept-labeling prompt (TD-73): one runaway
# element name cannot dominate a prompt, and neither can a page with thousands of them.
# REWRITE_ELEMENTS_MAX_CHARS=4000

# --- Test execution timeouts (item 6) ---------------------------------------
# Three coupled values. Leave all three unset and behaviour is exactly as before.
#
# ASSERTION_TIMEOUT_MS      How long ONE emitted assertion/action may wait, e.g. toBeVisible,
#                           toHaveText, click, fill. Default 10000. Read at GENERATION time and
#                           baked into the spec — the spec is standalone (DECISIONS.md D-06) and
#                           cannot read this process's env when Playwright later runs it, so a
#                           change only affects specs generated afterwards.
#                           Does NOT touch SAFE_CLICK_HELPER's 2s/3s/5s fallback ladder: those are
#                           a bounded worst case tuned in TECH_DEBT.md TD-36, not a general wait.
#
# PLAYWRIGHT_TIMEOUT        Playwright's per-test budget — the WHOLE test() for one case. When set,
#                           it is used verbatim and step-count scaling is skipped entirely.
#                           When UNSET, the budget is max(50s, steps × PLAYWRIGHT_STEP_BUDGET_MS),
#                           so a 25-step case is not held to the same ceiling as a 3-step one.
#
# PLAYWRIGHT_STEP_BUDGET_MS Per-step allowance used by that scaling. Default 6000. Ignored when
#                           PLAYWRIGHT_TIMEOUT is set.
#
# PLAYWRIGHT_VIDEO          Video recording. Unset (default) = "retain-on-failure": only a case
#                           PLAYWRIGHT ITSELF failed keeps a recording. "on" = record every case,
#                           passing ones included. "off" = record nothing.
#
#                           Why "on" exists: `blocked`, `truncated` and `truncated_no_assertion`
#                           are all outcomes where Playwright PASSED and the pipeline reclassified
#                           the result afterwards — so under the default, Playwright has already
#                           deleted those recordings and those cards can never show a video. No UI
#                           change can conjure a file that was never written.
#
#                           NOT free, which is why it defaults off: a video per case on a
#                           deployment whose storage is ephemeral. Same reasoning that keeps
#                           `trace` on retain-on-failure (a trace per passing run was ~80% of the
#                           runs/ folder).
#
#                           Exact strings only — "ON"/"true"/"1" all read as unset and give you
#                           retain-on-failure with no warning. executor.ts also sets this to "off"
#                           by itself when ffmpeg is missing, and that always wins over "on".
#
# The SIGKILL backstop in executor.ts is DERIVED from the per-test budget (budget + 50s), never
# fixed — it must stay above it so Playwright's JSON reporter can still write results.json. TD-02
# measured a too-tight gap killing the child on both the attempt and its retry, leaving the failure
# diagnosis with no error text at all. Raising the budget without raising the backstop reproduces
# that, which is why it is not a separate knob.
# ASSERTION_TIMEOUT_MS=10000
# PLAYWRIGHT_TIMEOUT=
# PLAYWRIGHT_STEP_BUDGET_MS=6000
# PLAYWRIGHT_VIDEO=
