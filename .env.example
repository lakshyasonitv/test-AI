# Gemini keys — comma-separated. These DO stack quota only if each key is from a
# DISTINCT Google Cloud project / Google account. Four teammates' own-account keys
# ≈ 4x free quota, legitimately. Two keys in the same project do NOT stack.
GEMINI_API_KEYS='your-gemini-api-key-here'

# Groq keys — comma-separated. Groq enforces limits at the ORG level, so extra keys
# in one account add NO quota; list them only for failover. Do NOT create multiple
# accounts to pool quota (Groq ToS prohibits it). If Groq throughput is the wall,
# upgrade that one account to the paid Developer tier.
GROQ_API_KEYS='your-groq-api-key-here'

# Models (override if the free-tier lineup changes — verify at the rate-limit pages).
# Groq deprecates and shuts down models on a rolling schedule — check
# https://console.groq.com/docs/deprecations before assuming a model id below still
# works. llama-3.3-70b-versatile was deprecated 2026-06-17, shut down 2026-08-16;
# openai/gpt-oss-120b is Groq's recommended replacement and is also cheaper.

GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MODEL_LITE=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# Cost + reliability ceilings. All optional — the defaults shown are what the code uses.
# These are the levers that bound what one run can spend; raise them deliberately.
#
# LLM_TIMEOUT_MS          per-ATTEMPT abort for any Gemini/Groq call. A hung fetch never
#                         settles, so without this a run can sit at "ir started" forever.
#                         Worst case per call is LLM_TIMEOUT_MS x the backoff retry count.
# MAX_GROQ_CALLS_PER_RUN  hard cap on Groq requests for a whole run, shared across the
#                         primary case, self-heal, and every suite case. Real spend is
#                         recorded to runs/<id>/08-groq-usage.json.
# MAX_IR_ATTEMPTS         IR generate/validate retries per test case. Each rejected IR
#                         (bad schema, ungrounded step, vacuous or hallucinated assertion)
#                         costs one attempt.
# MAX_LIVE_EXTENSIONS     browser replays allowed per case to discover pages behind a
#                         login/click. Each one is a real Chromium launch. NOTE: each replay
#                         also consumes one MAX_IR_ATTEMPTS attempt, so raising this without
#                         raising that leaves fewer attempts for actually converging on an IR.
# MAX_CONCURRENT_RUNS     pipeline runs in flight at once — bounds concurrent Chromium
#                         instances, i.e. how big a box this needs.
# SCREENSHOT_SETTLE_MS    gap between the frames used to detect that a page has stopped
#                         animating (default 150). Raise it if a site's entrance animation is
#                         slow enough that screenshots still land mid-fade.
# SCREENSHOT_MAX_SAMPLES  ceiling on those frames (default 10), so a page that animates forever
#                         can't stall a run.
# CREDENTIAL_WAIT_MS      how long a run pauses waiting for you to supply a login before
#                         giving up and testing without one. A paused run holds one of the
#                         MAX_CONCURRENT_RUNS slots, so don't set this very high.
LLM_TIMEOUT_MS=45000
MAX_GROQ_CALLS_PER_RUN=60
MAX_IR_ATTEMPTS=4
MAX_LIVE_EXTENSIONS=5
MAX_CONCURRENT_RUNS=3
SCREENSHOT_SETTLE_MS=150
SCREENSHOT_MAX_SAMPLES=10
CREDENTIAL_WAIT_MS=300000

# Case-selection gate — pauses a run after generating a batch of test cases so you can
# review/accept/reject them before they execute, and can ask for a regenerated batch
# ("not satisfied") instead of the model's first guess. Off by default: the pipeline runs
# straight through with no pause, same as before this feature existed.
# ENABLE_CASE_SELECTION_GATE  set to "true" to turn the gate on.
# MAX_CASE_REGEN_ATTEMPTS     "not satisfied" regeneration rounds allowed before the gate
#                             gives up and runs with whatever's been accepted so far.
# MAX_ACCUMULATED_CASES       cap on cases accepted into the pool across all rounds.
# CASE_SELECTION_WAIT_MS      how long a round stays parked waiting for your pick before it
#                             times out as "done" with nothing new accepted. A paused run
#                             holds one of the MAX_CONCURRENT_RUNS slots, same caveat as
#                             CREDENTIAL_WAIT_MS above.
ENABLE_CASE_SELECTION_GATE=false
MAX_CASE_REGEN_ATTEMPTS=3
MAX_ACCUMULATED_CASES=5
CASE_SELECTION_WAIT_MS=600000

# AppModel context caps — bound the size of the lite model embedded in testCases.ts's and ir.ts's
# LLM prompts. A rich site (large tables, deep mega-menus) with no caps here can produce a
# 17,000+ line model JSON and trip a 413 from Gemini/Groq. Defaults sit above every page observed
# in this project's own sampled runs (max 87 elements/page, 2 forms/page, 9 fields/form, 18 nav
# nodes, 3 buttons/page, 28 headings/page) — no effect on an ordinary site, only engages on a
# genuinely richer one. Elements/forms/nav are capped preferring named, interactive-role content
# over anonymous/positional content, so a cap prunes noise before it prunes a login form.
# MAX_LITE_ELEMENTS_PER_PAGE   named/interactive elements kept per page before anonymous ones
#                              fill the rest of the budget.
# MAX_LITE_FORMS_PER_PAGE      <form>s kept per page.
# MAX_LITE_FORM_FIELDS         fields kept per form.
# MAX_LITE_NAV_NODES_PER_PAGE  total nodes (all levels combined) from a page's navigation tree —
#                              one shared budget across the whole tree, not per level, so a wide
#                              AND deep mega-menu can't multiply past it.
# MAX_LITE_NAV_DEPTH           navigation tree levels kept; deeper nodes are pruned to a leaf.
# MAX_LITE_BUTTONS_PER_PAGE    buttons kept per page.
# MAX_LITE_HEADINGS_PER_PAGE   headings kept per page.
MAX_LITE_ELEMENTS_PER_PAGE=150
MAX_LITE_FORMS_PER_PAGE=5
MAX_LITE_FORM_FIELDS=20
MAX_LITE_NAV_NODES_PER_PAGE=60
MAX_LITE_NAV_DEPTH=3
MAX_LITE_BUTTONS_PER_PAGE=40
MAX_LITE_HEADINGS_PER_PAGE=40

# Web UI port (optional)
PORT=3000
